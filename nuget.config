<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: central package management wants a single source, and a restore must not depend on the
       sources configured on a developer's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
