@* A new order, step by step (the admin acts for the customer, ADR 0006): customer -> address -> partner -> pickup
   point -> products -> summary. The order's id is made once per wizard (ADR 0009), so placing it again after a lost
   answer returns the same order. Prices, the address and the fee are copied by OrderingService.PlaceAsync. *@
@inject CrmService Crm
@inject CatalogService Catalog
@inject OrderingService Ordering

<Modal Title="New order" Description="@Steps[_step]" Wide="true" OnClose="OnClose">
    <ol class="mb-5 flex flex-wrap gap-1.5 text-xs">
        @for (var i = 0; i < Steps.Length; i++)
        {
            var index = i;
            <li>
                <button type="button" disabled="@(index > Reachable)" @onclick="() => _step = index"
                        class="@($"rounded-full border px-3 py-1 font-medium {(index == _step ? "border-primary bg-primary text-primary-foreground" : index < _step ? "border-primary/40 text-primary" : "border-border text-muted-foreground")}")">
                    @(index + 1). @StepNames[index]
                </button>
            </li>
        }
    </ol>

    <ErrorAlert Message="@_error" />

    <div class="min-h-80">
        @switch (_step)
        {
            case 0:
                <input class="input mb-3" placeholder="Search by name or e-mail" @bind="_customerSearch" @bind:event="oninput" aria-label="Search customers" />
                <ul class="max-h-96 divide-y divide-border overflow-y-auto rounded-lg border border-border">
                    @foreach (var customer in Customers)
                    {
                        <li>
                            <button type="button" class="@Choice(_customer?.Id == customer.Id)" @onclick="() => ChooseCustomerAsync(customer)">
                                <Avatar Name="@customer.DisplayName" Class="size-8 bg-accent text-xs text-accent-foreground" />
                                <span class="min-w-0 text-left">
                                    <span class="block font-medium">@customer.DisplayName</span>
                                    <span class="block text-xs text-muted-foreground">@customer.Email · @customer.DefaultCity</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                break;
            case 1:
                @if (_addresses.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">This customer has no delivery address - add one on the customer's page.</p>
                }
                <ul class="grid gap-2 sm:grid-cols-2">
                    @foreach (var address in _addresses)
                    {
                        <li>
                            <button type="button" class="@($"{Choice(_address?.Id == address.Id)} rounded-lg border border-border")" @onclick="() => ChooseAddressAsync(address)">
                                <Icon Name="map-pin" Class="size-4 shrink-0 text-chart-2" />
                                <span class="min-w-0 text-left">
                                    <span class="flex items-center gap-2 font-medium">
                                        @address.Label
                                        @if (address.IsDefault)
                                        {
                                            <span class="badge badge-primary">default</span>
                                        }
                                    </span>
                                    <span class="block text-xs text-muted-foreground">@address.AddressLine, @address.Postcode @address.City</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                break;
            case 2:
                <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var partner in _partners)
                    {
                        <li>
                            <button type="button" class="@($"{Choice(_partner?.Id == partner.Id)} rounded-lg border border-border")" @onclick="() => ChoosePartnerAsync(partner)">
                                <Icon Name="@Labels.PartnerIcon(partner.Kind)" Class="size-4 shrink-0 text-chart-1" />
                                <span class="min-w-0 text-left">
                                    <span class="block font-medium">@partner.Name</span>
                                    <span class="block text-xs text-muted-foreground">@Labels.PartnerKind(partner.Kind) · @partner.ActivePickupPoints points</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                break;
            case 3:
                <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
                    <ul class="space-y-2">
                        @foreach (var point in _points)
                        {
                            var quote = _quotes.GetValueOrDefault(point.Id);
                            var open = point.IsOpenNow && quote?.Deliverable == true;
                            <li>
                                <button type="button" disabled="@(!open)" class="@($"{Choice(_point?.Id == point.Id)} rounded-lg border border-border disabled:opacity-50")"
                                        @onclick="() => ChoosePoint(point)">
                                    <Icon Name="store" Class="size-4 shrink-0 text-chart-1" />
                                    <span class="min-w-0 flex-1 text-left">
                                        <span class="block font-medium">@point.Name</span>
                                        <span class="block text-xs text-muted-foreground">
                                            @point.AddressLine · @Labels.Clock(point.OpensMinute)-@Labels.Clock(point.ClosesMinute)
                                            @if (!point.IsOpenNow)
                                            {
                                                <span class="text-destructive"> · closed now</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="text-right text-xs whitespace-nowrap">
                                        <span class="block tabular-nums">@Labels.Distance(quote?.DistanceM)</span>
                                        <span class="block font-medium">
                                            @(quote?.Deliverable == true ? Labels.Money(quote.DeliveryFeeMinor, "PLN") : "too far")
                                        </span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                    <Map Class="h-80" Label="Pickup points and the delivery address" Markers="PointMarkers" />
                </div>
                break;
            case 4:
                <div class="mb-3 flex flex-wrap items-center gap-2">
                    <input class="input max-w-xs" placeholder="Search products" @bind="_productSearch" @bind:event="oninput" aria-label="Search products" />
                    <span class="text-sm text-muted-foreground">@_products.Count listed by @_partner?.Name</span>
                </div>
                <ul class="max-h-96 divide-y divide-border overflow-y-auto rounded-lg border border-border">
                    @foreach (var product in Products)
                    {
                        var quantity = _quantities.GetValueOrDefault(product.Id);
                        <li class="flex items-center gap-3 px-3 py-2">
                            <span class="min-w-0 flex-1">
                                <span class="block font-medium">
                                    @product.Name
                                    @if (product.AgeRestricted)
                                    {
                                        <span class="badge badge-outline ml-1">18+</span>
                                    }
                                </span>
                                <span class="block text-xs text-muted-foreground">@Labels.Category(product.Category) · @Labels.Weight(product.WeightG) · size @product.SizeClass</span>
                            </span>
                            <span class="w-24 text-right text-sm tabular-nums">@Labels.Money(product.PriceMinor, product.Currency)</span>
                            <span class="flex items-center gap-1">
                                <button type="button" class="btn btn-outline btn-icon" aria-label="One less @product.Name" disabled="@(quantity == 0)"
                                        @onclick="() => SetQuantity(product, quantity - 1)"><Icon Name="minus" /></button>
                                <span class="w-8 text-center font-medium tabular-nums">@quantity</span>
                                <button type="button" class="btn btn-outline btn-icon" aria-label="One more @product.Name"
                                        @onclick="() => SetQuantity(product, quantity + 1)"><Icon Name="plus" /></button>
                            </span>
                        </li>
                    }
                </ul>
                break;
            default:
                <div class="grid gap-4 lg:grid-cols-2">
                    <div class="space-y-3 text-sm">
                        <p><span class="text-muted-foreground">Customer:</span> <span class="font-medium">@_customer?.DisplayName</span></p>
                        <p><span class="text-muted-foreground">Deliver to:</span> @_address?.Label - @_address?.AddressLine, @_address?.City</p>
                        <p><span class="text-muted-foreground">Pick up at:</span> @_partner?.Name, @_point?.Name (@_point?.AddressLine)</p>
                        <p><span class="text-muted-foreground">Distance:</span> @Labels.Distance(Quote?.DistanceM) in a straight line</p>
                        @if (Chosen.Any(c => c.Product.AgeRestricted))
                        {
                            <p class="flex items-center gap-2 text-warning"><Icon Name="id-card" /> 18+ products: the courier checks the customer's ID.</p>
                        }
                    </div>
                    <div class="rounded-lg border border-border">
                        <table class="table">
                            <tbody>
                                @foreach (var (product, quantity) in Chosen)
                                {
                                    <tr>
                                        <td>@quantity × @product.Name</td>
                                        <td class="text-right tabular-nums">@Labels.Money(product.PriceMinor * quantity, product.Currency)</td>
                                    </tr>
                                }
                                <tr><td class="text-muted-foreground">Goods</td><td class="text-right tabular-nums">@Labels.Money(Goods, "PLN")</td></tr>
                                <tr><td class="text-muted-foreground">Delivery fee</td><td class="text-right tabular-nums">@Labels.Money(Quote?.DeliveryFeeMinor, "PLN")</td></tr>
                                <tr>
                                    <td>
                                        <span class="text-muted-foreground">Tip for the courier</span>
                                        <span class="ml-2 inline-flex gap-1" role="radiogroup" aria-label="Tip for the courier">
                                            @foreach (var percent in TipPercents)
                                            {
                                                <button type="button" role="radio" aria-checked="@(_tipPercent == percent)"
                                                        class="@($"btn btn-sm {(_tipPercent == percent ? "btn-primary" : "btn-outline")}")"
                                                        @onclick="() => _tipPercent = percent">@percent %</button>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-right tabular-nums">@Labels.Money(Tip, "PLN")</td>
                                </tr>
                                <tr class="font-semibold"><td>Total</td><td class="text-right tabular-nums">@Labels.Money(Goods + (Quote?.DeliveryFeeMinor ?? 0) + Tip, "PLN")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                break;
        }
    </div>

    <div class="mt-5 flex items-center justify-between gap-2 border-t border-border pt-4">
        <button type="button" class="btn btn-ghost" disabled="@(_step == 0)" @onclick="() => _step--"><Icon Name="chevron-left" /> Back</button>
        @if (_step == 4)
        {
            <span class="text-sm text-muted-foreground tabular-nums">@Chosen.Sum(c => c.Quantity) items · @Labels.Money(Goods, "PLN")</span>
        }
        @if (_step < Steps.Length - 1)
        {
            <button type="button" class="btn btn-primary" disabled="@(_step >= Reachable)" @onclick="() => _step++">Next <Icon Name="chevron-right" /></button>
        }
        else
        {
            <button type="button" class="btn btn-primary" disabled="@_placing" @onclick="PlaceAsync"><Icon Name="check" /> Place order</button>
        }
    </div>
</Modal>

@code {
    private static readonly string[] StepNames = ["Customer", "Address", "Partner", "Pickup point", "Products", "Summary"];

    private static readonly string[] Steps =
    [
        "Who orders.",
        "Where it goes - copied into the order, later changes do not move it.",
        "One partner per order.",
        "Where the courier picks it up. The fee goes by the straight-line distance.",
        "Products the partner lists as available. The shelf is checked at picking.",
        "Check, add a tip for the courier if the customer wants, and place. Prices are copied as they are now.",
    ];

    private readonly Guid _newId = Guid.CreateVersion7();
    private int _step;
    private List<CustomerRow> _customers = [];
    private IReadOnlyList<CustomerAddressRow> _addresses = [];
    private List<PartnerRow> _partners = [];
    private List<PickupPointRow> _points = [];
    private Dictionary<Guid, QuoteRow> _quotes = [];
    private IReadOnlyList<ProductRow> _products = [];
    private readonly Dictionary<Guid, int> _quantities = [];
    private CustomerRow? _customer;
    private CustomerAddressRow? _address;
    private PartnerRow? _partner;
    private PickupPointRow? _point;
    private string _customerSearch = "";
    private string _productSearch = "";
    private bool _placing;
    private string? _error;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Guid> OnPlaced { get; set; }

    /// <summary>The last step that may be opened: every earlier one is chosen.</summary>
    private int Reachable =>
        _customer is null ? 0
        : _address is null ? 1
        : _partner is null ? 2
        : _point is null ? 3
        : Chosen.Any() ? 5
        : 4;

    private IEnumerable<CustomerRow> Customers =>
        _customers.Where(c =>
            _customerSearch.Length == 0
            || c.DisplayName.Contains(_customerSearch, StringComparison.OrdinalIgnoreCase)
            || c.Email.Contains(_customerSearch, StringComparison.OrdinalIgnoreCase)
        );

    private IEnumerable<ProductRow> Products =>
        _products.Where(p =>
            _productSearch.Length == 0
            || p.Name.Contains(_productSearch, StringComparison.OrdinalIgnoreCase)
            || p.Category.Contains(_productSearch, StringComparison.OrdinalIgnoreCase)
        );

    private IEnumerable<(ProductRow Product, int Quantity)> Chosen =>
        _products.Where(p => _quantities.GetValueOrDefault(p.Id) > 0).Select(p => (p, _quantities[p.Id]));

    private long Goods => Chosen.Sum(c => c.Product.PriceMinor * c.Quantity);

    /// <summary>The courier's tip the customer chooses when paying: a share of the goods, all of it to the courier.</summary>
    private static readonly IReadOnlyList<int> TipPercents = Order.TipPercents;

    private int _tipPercent;

    private long Tip => (long)Math.Round(Goods * _tipPercent / 100m, MidpointRounding.AwayFromZero);

    private QuoteRow? Quote => _point is null ? null : _quotes.GetValueOrDefault(_point.Id);

    private IReadOnlyList<MapMarker> PointMarkers =>
    [
        .. _points.Select(p => new MapMarker(p.Latitude, p.Longitude, p.Name, _point?.Id == p.Id ? "pickup" : "muted")),
        .. _address is null ? [] : new[] { new MapMarker(_address.Latitude, _address.Longitude, _address.Label, "customer") },
    ];

    private static string Choice(bool chosen) =>
        $"flex w-full items-center gap-3 px-3 py-2.5 transition-colors hover:bg-muted/60 {(chosen ? "bg-accent text-accent-foreground ring-2 ring-primary/50" : "")}";

    protected override async Task OnInitializedAsync()
    {
        _customers = (await Crm.ListCustomersAsync()).ToList();
        _partners = (await Crm.ListPartnersAsync())
            .Where(p => p is { Status: PartnerStatus.Active, ActivePickupPoints: > 0 })
            .ToList();
    }

    private async Task ChooseCustomerAsync(CustomerRow customer)
    {
        _error = null;
        if (_customer?.Id != customer.Id)
        {
            _customer = customer;
            _address = null;
            _point = null;
            _addresses = await Crm.ListAddressesAsync(customer.Id);
            _address = _addresses.FirstOrDefault(a => a.IsDefault);
        }
        _step = 1;
    }

    private async Task ChooseAddressAsync(CustomerAddressRow address)
    {
        _error = null;
        if (_address?.Id != address.Id)
        {
            _address = address;
            _point = null;
            _quotes = [];
            if (_partner is not null)
                await QuoteAsync();
        }
        _step = 2;
    }

    private async Task ChoosePartnerAsync(PartnerRow partner)
    {
        _error = null;
        if (_partner?.Id != partner.Id)
        {
            _partner = partner;
            _point = null;
            _quantities.Clear();
            _points = (await Crm.ListPickupPointsAsync(partner.Id, PickupPointStatus.Active)).ToList();
            _products = await Catalog.ListProductsAsync(partner.Id, listedAvailable: true);
            await QuoteAsync();
        }
        _step = 3;
    }

    /// <summary>The fee from each point of the partner to the chosen address; the nearest open one is preselected.</summary>
    private async Task QuoteAsync()
    {
        var quotes = new Dictionary<Guid, QuoteRow>();
        if (_address is not null)
            foreach (var point in _points)
                if (await Ordering.QuoteAsync(point.Id, _address.Id) is { } quote)
                    quotes[point.Id] = quote;
        _quotes = quotes;
        _points = _points.OrderBy(p => _quotes.GetValueOrDefault(p.Id)?.DistanceM ?? int.MaxValue).ToList();
        _point ??= _points.FirstOrDefault(p => p.IsOpenNow && _quotes.GetValueOrDefault(p.Id)?.Deliverable == true);
    }

    private void ChoosePoint(PickupPointRow point)
    {
        _point = point;
        _step = 4;
    }

    private void SetQuantity(ProductRow product, int quantity) => _quantities[product.Id] = Math.Max(0, quantity);

    private async Task PlaceAsync()
    {
        if (_customer is null || _address is null || _point is null)
            return;
        _placing = true;
        _error = null;
        var result = await Ordering.PlaceAsync(
            new PlaceOrder(
                _newId,
                _customer.Id,
                _address.Id,
                _point.Id,
                Chosen.Select(c => new LineInput(c.Product.Id, c.Quantity)).ToList(),
                _tipPercent
            )
        );
        _placing = false;
        if (result.Error is { } error)
            _error = error.Message;
        else
            await OnPlaced.InvokeAsync(_newId);
    }
}
