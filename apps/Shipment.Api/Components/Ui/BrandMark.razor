<a href="dashboard" class="@($"flex items-center gap-2.5 {TextClass} {Class}")">
    <span class="flex size-8 items-center justify-center rounded-lg bg-brand text-white">
        <Icon Name="package" Class="size-4.5" />
    </span>
    <span class="text-[15px] font-semibold tracking-tight">Shipment</span>
</a>

@code {
    [Parameter]
    public string Class { get; set; } = "";

    /// <summary>White on the navy sidebar; the page's foreground elsewhere.</summary>
    [Parameter]
    public string TextClass { get; set; } = "text-white";
}
