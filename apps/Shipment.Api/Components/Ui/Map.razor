@* Leaflet + OpenStreetMap (wwwroot/js/map.js). Markers are redrawn when the list changes; with Picking a click on the
   map reports its coordinates (OnPick) - the forms use it for a new address or pickup point. *@
@implements IAsyncDisposable
@inject IJSRuntime Js

<div @ref="_element" class="@($"overflow-hidden rounded-lg border border-border {Class}")" role="application" aria-label="@Label"></div>

@code {
    // Kraków's Main Square: where the map opens with nothing to show.
    private const decimal DefaultLatitude = 50.0617m;
    private const decimal DefaultLongitude = 19.9373m;

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<Map>? _self;
    private IReadOnlyList<MapMarker>? _shown;
    private IReadOnlyList<MapLine>? _linesShown;
    private (bool Picking, decimal? Latitude, decimal? Longitude) _picker;

    [Parameter]
    public IReadOnlyList<MapMarker> Markers { get; set; } = [];

    /// <summary>Route lines under the markers; the map fits them the first time there are any.</summary>
    [Parameter]
    public IReadOnlyList<MapLine> Lines { get; set; } = [];

    [Parameter]
    public string Class { get; set; } = "h-80";

    [Parameter]
    public string Label { get; set; } = "Map";

    /// <summary>A click on the map picks a place (crosshair cursor, a purple circle).</summary>
    [Parameter]
    public bool Picking { get; set; }

    [Parameter]
    public decimal? PickedLatitude { get; set; }

    [Parameter]
    public decimal? PickedLongitude { get; set; }

    [Parameter]
    public EventCallback<(decimal Latitude, decimal Longitude)> OnPick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
            _map = await _module.InvokeAsync<IJSObjectReference>(
                "create",
                _element,
                _self,
                new { latitude = DefaultLatitude, longitude = DefaultLongitude, zoom = 12 }
            );
        }
        if (_map is null)
            return;
        if (!ReferenceEquals(_shown, Markers))
        {
            // Fit only when the set of markers is new, so a redraw keeps what the user zoomed into.
            await _map.InvokeVoidAsync(
                "setMarkers",
                Markers.Select(m => new { m.Latitude, m.Longitude, m.Label, m.Kind, m.Popup }),
                _shown is null || _shown.Count != Markers.Count
            );
            _shown = Markers;
        }
        if (!ReferenceEquals(_linesShown, Lines))
        {
            await _map.InvokeVoidAsync(
                "setLines",
                Lines.Select(l => new { points = l.Points.Select(p => new[] { p.Latitude, p.Longitude }), kind = l.Kind }),
                (_linesShown is null || _linesShown.Count == 0) && Lines.Count > 0
            );
            _linesShown = Lines;
        }
        var picker = (Picking, PickedLatitude, PickedLongitude);
        if (picker != _picker && (firstRender || picker.Picking != _picker.Picking))
            await _map.InvokeVoidAsync("setPicker", Picking, PickedLatitude, PickedLongitude);
        _picker = picker;
    }

    [JSInvokable]
    public Task Picked(decimal latitude, decimal longitude) => OnPick.InvokeAsync((latitude, longitude));

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone with the browser tab: nothing left to clean up there.
        }
        _self?.Dispose();
    }
}
