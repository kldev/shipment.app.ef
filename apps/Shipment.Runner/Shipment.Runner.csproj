<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The runner (ADR 0007): what Shipment does after the request - hands messaging.outbox_messages on to RabbitMQ through
       Wolverine and handles them by calling the reacting module's application service. Web SDK only for /health and
       /health/ready; no other endpoint. -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <!-- Wolverine compiles its handler code at start; without it the host refuses to run. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../libs/Shipment.Application/Shipment.Application.csproj" />
    <ProjectReference Include="../../libs/Shipment.Observability/Shipment.Observability.csproj" />
  </ItemGroup>
</Project>
