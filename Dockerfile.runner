# The runner (ADR 0007): the outbox relay and the handlers (integration events between modules) - Wolverine on RabbitMQ. No port for people:
# /health and /health/ready on 8080 inside the network only.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG CONFIGURATION=Release
# The Husky target must not run in the image (no .git, no tools).
ENV HUSKY=0
WORKDIR /src

# 1) Only what restore needs - cached until dependencies change. Keep the list the closure of Shipment.Runner's references.
COPY global.json Directory.Build.props Directory.Packages.props nuget.config ./
COPY apps/Shipment.Runner/Shipment.Runner.csproj apps/Shipment.Runner/
COPY libs/Shipment.Application/Shipment.Application.csproj libs/Shipment.Application/
COPY libs/Shipment.Domain/Shipment.Domain.csproj libs/Shipment.Domain/
COPY libs/Shipment.Geo/Shipment.Geo.csproj libs/Shipment.Geo/
COPY libs/Shipment.Messaging.Contracts/Shipment.Messaging.Contracts.csproj libs/Shipment.Messaging.Contracts/
COPY libs/Shipment.Observability/Shipment.Observability.csproj libs/Shipment.Observability/
COPY libs/Shipment.Persistence/Shipment.Persistence.csproj libs/Shipment.Persistence/
RUN dotnet restore apps/Shipment.Runner/Shipment.Runner.csproj

# 2) Sources and publish.
COPY libs/ libs/
COPY apps/Shipment.Runner/ apps/Shipment.Runner/
RUN dotnet publish apps/Shipment.Runner/Shipment.Runner.csproj \
    --configuration $CONFIGURATION \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build --chown=$APP_UID /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

USER $APP_UID

ENTRYPOINT ["dotnet", "Shipment.Runner.dll"]
