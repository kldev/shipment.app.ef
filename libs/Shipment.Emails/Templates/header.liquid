<!-- Brand bar in Ambit's navy: the application's mark and name. -->
<tr>
   <td style="padding: 0; background-color: #1e4f8f;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%;">
         <tr>
            <td style="padding: 22px 32px;">
               <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
                  <tr>
                     <td width="36" style="padding-right: 12px; vertical-align: middle;">
                        <div style="width: 36px; height: 36px; background-color: #ffffff; border-radius: 4px; color: #1e4f8f;
                                    font-size: 15px; font-weight: 700; line-height: 36px; text-align: center;">{{ AppMark }}</div>
                     </td>
                     <td style="vertical-align: middle;">
                        <div style="font-size: 15px; font-weight: 600; color: #ffffff; line-height: 20px;">{{ AppName }}</div>
                        <div style="font-size: 11px; font-weight: 500; color: #c4d4ea; line-height: 16px; letter-spacing: 1.4px;
                                    text-transform: uppercase;">Deliveries</div>
                     </td>
                  </tr>
               </table>
            </td>
         </tr>
      </table>
   </td>
</tr>
