  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shipment.Domain/Shipment.Domain.csproj" />
    <ProjectReference Include="../Shipment.Messaging.Contracts/Shipment.Messaging.Contracts.csproj" />
    <ProjectReference Include="../Shipment.Persistence/Shipment.Persistence.csproj" />
  </ItemGroup>
</Project>
